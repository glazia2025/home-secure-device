# ── gz_temp ESP32-P4 hub — build defaults ─────────────────────────────────
# Minimal, hand-written defaults (unlike the S3 hub, which checked in a full
# generated sdkconfig). `idf.py set-target esp32p4` regenerates the rest.

CONFIG_IDF_TARGET="esp32p4"

# ── Flash (FireBeetle 2 ESP32-P4 = 16 MB) ─────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── Custom partition table (same layout as the S3 hub) ────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ── Console on USB-Serial-JTAG — frees UART0..UART4 for peripherals ───────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# ── PSRAM (P4 has 32 MB) ──────────────────────────────────────────────────
CONFIG_SPIRAM=y

# ── Bluetooth: NimBLE host on the P4, controller on the C6 via ESP-Hosted ─
# The P4 has no on-chip BLE controller, so it is disabled here; NimBLE talks
# HCI to the C6 over the ESP-Hosted VHCI transport (SDIO). NOT the physical-UART
# HCI transport — that grabs UART1 (used by the camera) + pins 4/5 (R307
# fingerprint) and aborts in uart_driver_install ("driver already installed"),
# rebooting the hub the moment provisioning starts.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# Physical-UART HCI transport OFF; route HCI over ESP-Hosted VHCI instead.
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# Pin co-processor target to C6 — omitting this lets any reconfigure default to H2,
# which breaks the SPI handshake (C6 slave firmware won't respond to H2 packets).
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"

# ── Wi-Fi via esp_wifi_remote → esp-hosted → ESP32-C6 (SDIO) ──────────────
# esp_wifi_remote selects the hosted backend; the SDIO transport + C6 pins are
# pinned below via the ESP-Hosted board preset (see the SDIO block near EOF).
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_WIFI_RMT_CACHE_TX_BUFFER_NUM=32

# RAW-throughput transport benchmark is a DEBUG feature (Kconfig default n; esp_hosted
# stats.h: "disabled on production"). It spawns an infinite no-delay flood task on the SDIO
# transport (raw_tp_tx_task) and compiles raw-TP hooks into the hot RX path; combined with the
# WebRTC video TX burst it corrupts an internal-RAM FreeRTOS list -> Core-1 vListInsert panic in
# sdio_write_task. MUST stay off in production.
CONFIG_ESP_HOSTED_RAW_THROUGHPUT_TRANSPORT=n

# ── Native OV5647 MIPI-CSI camera + WebRTC (camera_csi.c / webrtc_stream.c) ─
# Compile the OV5647 sensor driver into esp_cam_sensor's detect array so the
# runtime probe finds it on the CSI bus.
CONFIG_CAMERA_OV5647=y
# esp_peer uses DTLS-SRTP to secure the WebRTC media (RTP/RTCP).
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y

# ── Native MIPI-DSI LCD (ILI9881C 720x1280) + LVGL (display.c / ui/) ───────
# DSI DMA ISR is intentionally NOT IRAM-safe: on the P4, IRAM and DRAM share one HP-RAM
# pool, and pulling the LCD DSI driver into IRAM costs ~15.5 KB of the internal-RAM heap —
# exactly the boot-time headroom the ESP-Hosted SDIO DMA mempool (buf_mp_g, sdio_drv.c)
# needs, so enabling it makes sdio_mempool_create fail with "no mem" before app_main.
# The display fix is carried by direct_mode (dirty-lines cache-sync), not by this flag.
# CONFIG_LCD_DSI_ISR_IRAM_SAFE is not set
# LVGL: RGB565. Unlike the S3 (SPI ILI9341, which needed LV_COLOR_16_SWAP=y),
# the DSI DPI panel takes native RGB565 — leave the byte-swap OFF.
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_16_SWAP is not set
# QR code widget: the register screen renders the hub-MAC QR (ui/screens.c).
CONFIG_LV_USE_QRCODE=y
# LVGL draw buffers live in PSRAM (720x1280 is far too big for internal RAM).
# LVGL's own allocator pool (mask/line render buffers) stays in fast internal DRAM, sized
# 32 KB (LVGL's default; down from 64). The freed ~32 KB of internal RAM offsets the IRAM
# that coredump's panic-handler code (IRAM_ATTR, must run cache-disabled) takes on the P4's
# unified HP-RAM pool, so the first heap block stays ~115 KB and the ESP-Hosted SDIO DMA
# mempool (buf_mp_g, sdio_drv.c) keeps its boot headroom. 32 KB is ample for the 720x1280
# dashboard; bump back to 48/64 once coredump is removed after root-causing the crash.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
# Montserrat font range for the re-scaled 720x1280 UI (small legacy sizes kept
# so the ui/fonts.h aliases resolve to real glyphs instead of degrading).
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ── High Speed PSRAM (fixes MIPI DSI bandwidth starvation) ────────────────
# ESP32-P4 Kconfig has SPIRAM_SPEED_200M (not 120M — that's S3 only).
# 200MHz is required: 720x1280@60Hz panel scan needs ~110 MB/s of PSRAM bandwidth.
# At 20MHz (default) the panel framebuffer is starved → solid cyan screen.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y

# ── ESP-Hosted C6 co-processor: 1 kHz tick to avoid bus jitter ────────────
# ESP-Hosted logs a warning at boot if FREERTOS_HZ < 1000; the P4↔C6 link
# for WiFi+BLE is sensitive to coarse tick timing.
CONFIG_FREERTOS_HZ=1000

# ── ISR stack hardening (round 7): prevent ISR-stack overflow into scheduler ──
# The P4 supports hardware-nested interrupts (SOC_INT_HW_NESTED_SUPPORTED=y).
# LVGL DPI flush, SDIO DMA, and WiFi transport ISRs can nest; the default
# 2096 B/core ISR stack overflows downward into pxReadyTasksLists, corrupting
# the scheduler ready-lists and causing the Core0 spinlock / Core1 0xffdeffde
# crash.  4096 B gives safe headroom for 2–3 levels of nesting.
CONFIG_FREERTOS_ISR_STACKSIZE=4096

# ── ESP-Hosted C6 over SDIO (DFR1172 FireBeetle 2 ESP32-P4 onboard C6) ─────
# CRITICAL: the onboard ESP32-C6 is wired to the P4 via SDIO, NOT SPI:
#   CLK=18 CMD=19 D0-D3=14/15/16/17 EN(reset)=54  (per DFRobot DFR1172 wiki).
# The Espressif P4 function-board preset carries exactly these SDIO pin
# defaults for a C6 slave, so selecting it + forcing the SDIO host interface
# gives the correct wiring with no per-pin overrides. (The previous SPI setup
# on GPIO 7/8/9/10/11/12 clashed with the I2C touch bus + PCM mic and the C6
# never answered the handshake.)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# SDIO RX mode: streaming=y matches p4_wifi ground truth.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y

# Keep the ESP-Hosted SDIO transport DMA mempool (buf_mp_g, sdio_drv.c) in PSRAM (=y).
# HARDWARE-VERIFIED THE OTHER WAY: setting this =n (mempool in internal DMA RAM) DOES NOT BOOT on this
# build — ESP-Hosted then allocates buf_mp_g (~50 KB) plus all the WiFi/serial/RPC transport buffers out
# of the scarce internal DMA heap, which our fuller build (DPI display + camera) can't spare, so
# sdio_mempool_create() returns NULL → `assert(buf_mp_g)` / `HS_MP: mempool create failed: no mem`
# in do_global_ctors, every boot. (The p4_wifi reference tolerates =n only because it has no display/
# camera eating internal RAM.) So =y is the only bootable state. On the P4 GDMA reaches PSRAM through
# cache, so the SDIO buffers work there. If the streaming cache-maintenance deadlock (HP_SYS_HP_WDT_RESET,
# s_get_cache_state) returns, fix it from the IRAM-panic backtrace at its source — NOT by starving
# internal RAM with =n, which just trades a late crash for a boot loop.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Display renders in LVGL direct mode into the DPI panel's two PSRAM framebuffers
# (num_fbs=2, see display.c) — double-buffered, so there is no internal-SRAM draw
# buffer that could overrun into the FreeRTOS lists.
# Catch any future stack overflow immediately (names the offending task) instead of
# letting it silently corrupt memory and crash the scheduler later.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# ── Coredump: DISABLED ───────────
# Flash coredump was abandoned: the stored dump's SHA is from an overwritten ELF and can never match
# the running app, so `idf.py coredump-info` always fails, and it just spams `Core dump flash config is
# corrupted`. The IRAM panic handler (below) prints a full, decoded backtrace over serial instead — no
# coredump needed, and this frees the reserved 1792 B coredump stack.
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# ── DIAGNOSTIC BUILD (round 6): catch the internal-RAM corruptor in the act ────────────────
# The ~22 s crash is real memory corruption (Core1 in LVGL software render, Core0's scheduler
# ready-list smashed), independent of display flush mode and memory layout, and the load-fault
# panic hangs before it can print (Core1 wedged mid-render → the interrupt-WDT reboots first).
# So instead of chasing a dump out of a wedged-core panic, catch the overrun at its source:
# COMPREHENSIVE heap poisoning checks every block's head/tail canary on every malloc/free, so
# the first heap-block overrun aborts with `CORRUPT HEAP: ... allocated by task ...` in NORMAL
# context (both cores healthy) where the message prints cleanly — naming the culprit task.
# Revert to LIGHT once the bug is root-caused (comprehensive poisoning slows the heap).
# Give any panic/abort ~5 s to finish printing the backtrace + coredump before the interrupt
# watchdog reboots (was 800 ms — too short once a core is wedged). Revert to 800 after.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000
# Run the panic handler from IRAM so it can print a full, readable register dump + backtrace even when
# the crash happens with the CPU cache disabled/stalled. Without this the panic path executes from cached
# flash and produces garbage during a cache-maintenance deadlock (the HP_SYS_HP_WDT_RESET we're chasing),
# so we never see the culprit task/backtrace. Cheap; keep it.
CONFIG_ESP_PANIC_HANDLER_IRAM=y
# NOTE: COMPREHENSIVE heap poisoning was tried here and BACKFIRED — its per-alloc canaries dropped
# the largest free internal block from 63488 to 57332, just under the 57600 B the HW H264 reference
# frame needs, so the encoder OOM'd on every stream attempt (No memory for reference frame). Left
# DISABLED. If poisoning is needed to localise the mid-stream SDIO corruption, use LIGHT (~1 B/alloc)
# — it fits now that the SDIO mempool moved to PSRAM (below) and freed internal headroom.
CONFIG_HEAP_POISONING_DISABLED=y

# Execute .text/.rodata from PSRAM (XIP), not from the flash cache. ROOT-CAUSE FIX for the
# HP_SYS_HP_WDT_RESET cross-core deadlock (CONFIRMED backtrace: Core0 wedged in
# esp_cpu_compare_and_set → spinlock_acquire → xPortEnterCriticalTimeout, port.c:545; the panic
# then DOUBLE-FAULTED in panic_print_str reading a flash-resident format string — proof the FLASH
# CACHE WAS DISABLED at crash time). On the P4 flash and PSRAM are independent MSPI controllers
# (SOC_MEMSPI_IS_INDEPENDENT=y): when a flash cache-disable op runs (NVS/flash write, or any
# cache-maintenance window), code in the flash cache is unreachable, so a core mid-critical-section
# can't make progress and the other core spins forever on its spinlock → INT_WDT. The known-good
# WiFi+BLE reference (sesnor_test/p4_wifi) has a byte-identical cache/SPIRAM/flash/mbedTLS/SDIO
# config and never deadlocks — the ONLY difference is it has no MIPI-DSI DPI PSRAM DMA making that
# cache-off window fatal. With XIP the CPU fetches from PSRAM (separate bus, mostly L2-cache hits)
# so execution + the panic printer survive a flash-cache-disable. Costs ~2.6 MB PSRAM for code
# (32 MB part, ~31.5 MB free) and a little PSRAM bandwidth; acceptable.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
